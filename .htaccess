# Krishna Aircons – Hostinger (Apache / LiteSpeed) settings
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) Force HTTPS and non-www (https://krishnaaircons.com)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 2) Hide build tools and project files from visitors
RewriteRule ^(_build|\.git)(/|$) - [F,L]
RewriteRule ^(README\.md|\.gitignore)$ - [F,L]

# 3) /index.html -> clean folder URL
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /%1 [L,R=301]

# 4) Old website URLs -> new pages (keeps Google rankings)
RewriteRule ^about-us/?$ /about/ [L,R=301,NC]
RewriteRule ^contact-us/?$ /contact/ [L,R=301,NC]
RewriteRule ^(our-services?|service)/?$ /services/ [L,R=301,NC]
RewriteRule ^ac-repair(-in)?(-vadodara)?/?$ /services/ac-repair-vadodara/ [L,R=301,NC]
RewriteRule ^ac-(repair-and-)?services?(-in)?(-vadodara)?/?$ /services/ac-service-vadodara/ [L,R=301,NC]
RewriteRule ^ac-?installation(-in)?(-vadodara)?/?$ /services/ac-installation-vadodara/ [L,R=301,NC]
RewriteRule ^ac-deep-cleaning(-in)?(-vadodara)?/?$ /services/ac-deep-cleaning-vadodara/ [L,R=301,NC]
RewriteRule ^ac-gas-(refilling|filling)(-in)?(-vadodara)?/?$ /services/ac-gas-refilling-vadodara/ [L,R=301,NC]
RewriteRule ^ac-amc(-in)?(-vadodara)?/?$ /services/ac-amc-vadodara/ [L,R=301,NC]
RewriteRule ^inverter-ac(-pcb)?-repair(-in)?(-vadodara)?/?$ /services/inverter-ac-repair-vadodara/ [L,R=301,NC]
RewriteRule ^ac-(shifting|dismantle|uninstallation)(-in)?(-vadodara)?/?$ /services/ac-shifting-vadodara/ [L,R=301,NC]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml
</IfModule>

# Browser caching (faster repeat visits = better SEO)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
